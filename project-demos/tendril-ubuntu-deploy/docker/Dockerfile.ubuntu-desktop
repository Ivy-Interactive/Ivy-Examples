# Ubuntu Desktop image for Sliplane (or any Docker host).
#
# Includes:
#   - Ubuntu 22.04 LTS
#   - XFCE4 desktop environment
#   - xrdp  (RDP access on port 3389 — connect with any RDP client)
#   - noVNC (browser-based VNC on PORT, default 8080)
#   - .NET SDK 9
#   - Ivy Tendril (dotnet global tool, available in terminal as `tendril`)
#   - JetBrains Rider (IDE at /opt/rider, launched via Applications menu or `rider`)
#
# Required env vars at runtime:
#   RDP_USER      – Linux username to create (default: developer)
#   RDP_PASSWORD  – Password for that user + VNC (default: TendrilRDP!1 – CHANGE THIS)
#   PORT          – noVNC HTTP port (default: 8080)
#
# Sliplane notes:
#   Set PORT env var and expose it as the service port (HTTP health-check target).
#   xrdp listens on 3389 — reachable at <server-ip>:3389 if your server's firewall allows it.

FROM ubuntu:22.04

# ── Non-interactive apt ────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ── Runtime defaults (override at deploy time) ─────────────────────────────────
ENV PORT=8080
ENV RDP_USER=developer
ENV RDP_PASSWORD=TendrilRDP!1
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="$PATH:/root/.dotnet/tools:/opt/rider/bin"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

# ── 1. System packages ─────────────────────────────────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # Desktop
    xfce4 xfce4-goodies xfce4-terminal \
    # RDP + VNC
    xrdp \
    tigervnc-standalone-server \
    # noVNC web client
    novnc websockify \
    # Utilities
    supervisor \
    dbus-x11 \
    x11-xserver-utils \
    x11-utils \
    sudo \
    wget \
    curl \
    git \
    unzip \
    ca-certificates \
    gnupg \
    apt-transport-https \
    # Rider runtime dependencies
    libfontconfig1 \
    libfreetype6 \
    libxi6 \
    libxrender1 \
    libxtst6 \
    libxext6 \
    libxrandr2 \
    libglib2.0-0 \
    libgbm1 \
    libasound2 \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# ── 2. .NET SDK 9 ──────────────────────────────────────────────────────────────
RUN wget -q https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb \
        -O /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends dotnet-sdk-9.0 \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Ivy Tendril ─────────────────────────────────────────────────────────────
RUN dotnet tool install --global Ivy.Tendril \
    && echo 'export PATH="$PATH:/root/.dotnet/tools"' >> /etc/profile.d/tendril-path.sh \
    && chmod +x /etc/profile.d/tendril-path.sh

# ── 4. JetBrains Rider ────────────────────────────────────────────────────────
# Pin to a known good release; bump ARG to upgrade.
ARG RIDER_VERSION=2024.3.6
RUN wget -q \
        "https://download.jetbrains.com/rider/JetBrains.Rider-${RIDER_VERSION}.tar.gz" \
        -O /tmp/rider.tar.gz \
    && tar -xzf /tmp/rider.tar.gz -C /opt \
    && find /opt -maxdepth 1 -type d -name "JetBrains Rider*" -exec mv {} /opt/rider \; \
    && rm /tmp/rider.tar.gz \
    && ln -s /opt/rider/bin/rider.sh /usr/local/bin/rider

# ── 5. xrdp: use XFCE session ─────────────────────────────────────────────────
RUN echo "startxfce4" > /etc/skel/.xsession \
    && chmod 755 /etc/skel/.xsession

# ── 6. noVNC: symlink index page ──────────────────────────────────────────────
RUN ln -sf /usr/share/novnc/vnc_lite.html /usr/share/novnc/index.html 2>/dev/null || true

# ── 7. Rider desktop shortcut (system-wide) ───────────────────────────────────
RUN mkdir -p /usr/share/applications \
    && printf '[Desktop Entry]\nName=JetBrains Rider\nExec=/opt/rider/bin/rider.sh %%F\nIcon=/opt/rider/bin/rider.svg\nType=Application\nCategories=Development;IDE;\nStartupNotify=true\n' \
       > /usr/share/applications/rider.desktop

# ── 8. Tendril desktop shortcut ───────────────────────────────────────────────
RUN printf '[Desktop Entry]\nName=Tendril\nExec=bash -c "tendril --web &amp;&amp; xdg-open http://localhost:8000"\nIcon=utilities-terminal\nType=Application\nCategories=Development;\nTerminal=false\n' \
    > /usr/share/applications/tendril.desktop

# ── 9. Entrypoint ─────────────────────────────────────────────────────────────
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3389
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
